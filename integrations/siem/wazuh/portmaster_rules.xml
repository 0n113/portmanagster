<!--
  Wazuh manager local rules for Portmaster (copy to /var/ossec/etc/rules/portmaster_rules.xml).
  Rule IDs 100800-100899. Test with: /var/ossec/bin/wazuh-logtest
-->
<group name="portmaster,">

  <!-- Base rule: every JSON event from the connection export (has "verdict" and "app").
       Level 0 on purpose: it only anchors the child rules and does not alert, so normal
       accepted connections do not flood the alert index. Raise to 3 to alert on everything. -->
  <rule id="100800" level="0">
    <decoded_as>json</decoded_as>
    <field name="verdict" type="pcre2">.+</field>
    <field name="app" type="pcre2">.+</field>
    <description>Portmaster: connection event</description>
  </rule>

  <!-- Blocked or dropped connection. -->
  <rule id="100801" level="5">
    <if_sid>100800</if_sid>
    <field name="verdict" type="pcre2">^(blocked|dropped)$</field>
    <description>Portmaster: connection blocked ($(app) -> $(domain) $(remoteIP))</description>
  </rule>

  <!-- Blocked by a filter list. -->
  <rule id="100802" level="7">
    <if_sid>100801</if_sid>
    <field name="reason" type="pcre2">(?i)filter list</field>
    <description>Portmaster: connection blocked by filter list ($(app) -> $(domain))</description>
  </rule>

  <!-- Malware/phishing lists. List IDs depend on the lists configured in Portmaster
       (e.g. MAL, PHISH, BAD); adjust the regex to your setup. filterLists is a JSON array;
       Wazuh flattens it into one field, the regex is not anchored so it works for
       either representation. Verify with wazuh-logtest. -->
  <rule id="100803" level="10">
    <if_sid>100801</if_sid>
    <field name="filterLists" type="pcre2">MAL|PHISH|BAD</field>
    <description>Portmaster: connection blocked by malware/phishing list ($(app) -> $(domain))</description>
  </rule>

  <!-- 20 blocked connections from the same app within 120 s. -->
  <rule id="100804" level="10" frequency="20" timeframe="120">
    <if_matched_sid>100801</if_matched_sid>
    <same_field>app</same_field>
    <description>Portmaster: many blocked connections from $(app) (20 in 120s)</description>
  </rule>

  <!-- Optional: blocked inbound connection from a public (non-private, non-loopback) address. -->
  <rule id="100805" level="6">
    <if_sid>100801</if_sid>
    <field name="direction" type="pcre2">^inbound$</field>
    <field name="remoteIP" type="pcre2">^(?!10\.|127\.|192\.168\.|172\.(1[6-9]|2\d|3[01])\.|169\.254\.|(?i:fe80:|fc|fd|::1$))</field>
    <description>Portmaster: inbound connection blocked from public address $(remoteIP)</description>
  </rule>

</group>

<group name="portmaster,">

  <!-- Status check (command monitoring). Wazuh rule 530 matches all command output
       ("ossec: output: '<command or alias>': ..."); with an alias the quoted name is the alias. -->
  <rule id="100810" level="0">
    <if_sid>530</if_sid>
    <match>^ossec: output: 'portmaster-status'</match>
    <description>Portmaster: status check output</description>
  </rule>

  <rule id="100811" level="12">
    <if_sid>100810</if_sid>
    <match>CRITICAL:</match>
    <description>Portmaster: status CRITICAL</description>
  </rule>

  <rule id="100812" level="10">
    <if_sid>100810</if_sid>
    <match>UNKNOWN:</match>
    <description>Portmaster: status UNKNOWN</description>
  </rule>

  <rule id="100813" level="5">
    <if_sid>100810</if_sid>
    <match>WARNING:</match>
    <description>Portmaster: status WARNING</description>
  </rule>

</group>
