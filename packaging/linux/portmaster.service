[Unit]
Description=Portmaster by Safing
Documentation=https://safing.io
Documentation=https://docs.safing.io
Before=nss-lookup.target network.target shutdown.target
After=systemd-networkd.service
Conflicts=shutdown.target
Conflicts=firewalld.service
Wants=nss-lookup.target
# Blocks the network from early boot until the core has set its rules.
Wants=portmaster-boot-guard.service
After=portmaster-boot-guard.service

[Service]
# The core reports ready (sd_notify) once its firewall rules are in place, so
# units ordered after network.target do not start before them.
Type=notify
TimeoutStartSec=120
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=24
LockPersonality=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
MemoryLow=2G
NoNewPrivileges=yes
PrivateTmp=yes
PIDFile=/var/lib/portmaster/core-lock.pid
Environment=LOGLEVEL=info
EnvironmentFile=-/etc/default/portmaster
ProtectSystem=true
# No ReadWritePaths for /usr/lib/portmaster: the package manager owns the
# binaries. Upstream software updates would replace this build with Safing's.
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictNamespaces=yes
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
PrivateDevices=yes
AmbientCapabilities=cap_chown cap_kill cap_net_admin cap_net_bind_service cap_net_broadcast cap_net_raw cap_sys_module cap_sys_ptrace cap_dac_override cap_fowner cap_fsetid cap_sys_resource cap_bpf cap_perfmon
CapabilityBoundingSet=cap_chown cap_kill cap_net_admin cap_net_bind_service cap_net_broadcast cap_net_raw cap_sys_module cap_sys_ptrace cap_dac_override cap_fowner cap_fsetid cap_sys_resource cap_bpf cap_perfmon
StateDirectory=portmaster
# TODO(ppacher): add --disable-software-updates once it's merged and the release process changed.
WorkingDirectory=/var/lib/portmaster
ExecStart=/usr/lib/portmaster/portmaster-core --log=${LOGLEVEL} --log-dir=/var/lib/portmaster/log
# Remove the firewall rules only after a clean stop. After a crash they stay:
# without the core, new connections are dropped instead of passing unfiltered
# until the service is back (RestartSec). `portmaster-core --recover-iptables`
# removes them by hand.
ExecStopPost=-/bin/sh -c 'if [ "$$SERVICE_RESULT" = success ]; then exec /usr/lib/portmaster/portmaster-core --recover-iptables; fi'

[Install]
WantedBy=multi-user.target
